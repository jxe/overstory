// ~/src/supplies-remake: games, their authors, and lists of games,
// as Beetle tables. Authors are Story accounts, so there is no Person
// model to declare. Who may edit a game is access policy now
// (`who: {property: authors}` in access.yaml), not schema.

main table Game:
  name:        Text
  status:      Status <-> games[]
  description: Markdown?
  tags:        Text[]  // values, stored on the row
  authors:     Person[] <-> games[] as array
  lists:       List[]  // cross-reference: declared below

table List:
  name:  Text
  games: ordered Game[] <-> lists[] as array

// @fold: in data files, these are arrays on Game and List rows rather than
// files of their own. A storage default; a placement may choose otherwise.

enum Status:
  color: Text
  Draft      { color: "#9aa0aa" }
  Playtested { color: "#bd861a" }
  Polished   { color: "#27815a" }

re Game:
  ~views([{ label: "By game", line: [status ~bullet, name, authors, description], sort: modified }, { label: "By author", group: authors }, { label: "By list", group: lists, sort: modified }])
