// expect: storage-on-plain-model
// expect: fold-and-table
// expect: stored-on-fixed
// expect: stored-on-fixed
table Book:
  title:    Text
  statuses: Status[] <-> book
  @fold(Shelf)

table Shelf:
  name: Text

connection table Placement:
  book:  Book <-> placements[]
  shelf: Shelf <-> placements[] as array
  @table
// An enum has no table to hold a column.
// Two models without tables have nowhere to keep their connection.

enum Status:
  people: Person[] <-> statuses[]
  Draft
  Done
