// expect: column-placement
// expect: column-placement
// expect: attribute-arguments
// expect: stored-on-fixed
// expect: fold-end
// expect: misplaced-attribute
// @column names the column that stores a connection, so it goes on the end
// whose model holds it: Episode here, not Series.
table Episode:
  title:  Text
  guests: Person[] <-> episodes[] @column("guest_ids")
  season: Season <-> episodes[] as array

table Series:
  title:    Text
  episodes: Episode[] <-> series @column("episode_ids")

// An unfolded n:m is its own table; its columns aren't either end's.

table Show:
  name: Text @column(name)

enum Status:
  @table("statuses")
  Draft
// Only an n:m folds, and only one end of it.

table Season:
  number: Int

table Tag:
  name:     Text
  episodes: Episode[] <-> tags[] as array

connection table Credit:
  episode: Episode <-> credits[] @fold
  person:  Person <-> credits[]
