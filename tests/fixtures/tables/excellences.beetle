// meaningalignment/excellences: the MAI roles document, as
// Beetle tables. Leads were a `person` collection with a portrait; now they are
// Story accounts, and portraits come from their profiles.

main table Excellence:
  name:       Text
  assessment: Assessment <-> excellences[]
  leads:      Person[] <-> excellences[]
  projects:   Project[] <-> excellences[]

table Project:
  name:        Text
  excellences: Excellence[]  // cross-reference

enum Assessment:
  color: Text
  Good            { color: "#27815a" }
  Improving       { color: "#bd861a" }
  Bad             { color: "#c25357" }
  "Current focus" { color: "#4278c0" }
  "Not recorded"  { color: "#9aa0aa" }

re Excellence:
  ~views([{ label: "By project", line: [name, leads ~label("lead"), assessment ~bullet, projects ~summary ~label("project")], group: projects }, { label: "By lead", group: leads }, { label: "By assessment", group: assessment }])
