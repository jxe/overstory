// Supplies' schema, in the one language. A collection's data tables can only be
// declared here; views, rules and mutations may sit beside them.
// Its tables are the same as before Supplies moved to Beetle.

main table List:
  name:        Text
  about:       Markdown?
  visibility:  Visibility <-> lists[]
  kind:        ListKind <-> lists[]
  openToEdits: Bool
  owner:       Person <-> ownedLists[]
  @index(owner, modified)  // my lists, newest first

table Practice:
  name:    unique Text
  about:   Markdown?
  authors: Person[] <-> practices[]

// A connection table, because tags hang off it.
connection table Item:
  list:     List <-> ordered items[]
  practice: Practice <-> items[]

// A tag's id is unique only within its list.
table Tag (list, id):
  name:      Text
  color:     Text?
  list:      List <-> tags[]
  practices: Practice[] <-> tags[]

connection table Reaction:
  list:   List <-> reactions[]
  person: Person <-> reactions[]
  emoji:  Text

connection table Contribution:
  list:   List <-> contributors[]
  person: Person <-> contributions[]
  first:  Date = today  // a default, written only when the row is created
  last:   Date

enum Visibility:
  Public
  Private

enum ListKind:
  Standard
  Tagged

// --------------------------------------------------------------- arrangements
// What `~views` used to say: ordinary views over the standard Rows element, which
// Story draws natively and lets readers edit. Addressed as data/schema?view=ByOwner.

view ByOwner():
  <Rows for={l in List} group={l.owner} orderBy={l.modified desc}>
    <Bullet value={l.visibility} />
    <Text>{l.name}</Text>
    <Count of={l.items} />
  </Rows>

// Rules and mutations: ../mutations.beetle (they could sit here just as well).
