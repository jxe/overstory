// The people you know. Story adds one Tie per fact it sees (you're in a
// group or canopy together, you shared a tree with them, you opened their
// profile), keyed by the fact, so the same fact seen on two devices is one
// row. Contacts are yours to write: notes, and placeholders for people with
// no profile yet.
main table Tie:
  person: Person <-> ties[]
  group:  Person? <-> members[]
  kind:   TieKind <-> ties[]
  name:   Text?
  handle: Text?
  host:   Text?

table Contact:
  name:    Text
  profile: Person? <-> contacts[]
  reach:   Text?
  notes:   Markdown?

enum TieKind:
  Community
  Group
  Shared
  SharedWithYou
  Invited
  InvitedYou
  Opened

// One line per person, whatever the ties behind it.
re Tie:
  ~views([{ label: "By group", group: group, rows: person, line: [person] }, { label: "Everyone", rows: person, line: [person, group, kind], sort: person }, { label: "Recent", rows: person, line: [person, kind], sort: modified ~latest }])
